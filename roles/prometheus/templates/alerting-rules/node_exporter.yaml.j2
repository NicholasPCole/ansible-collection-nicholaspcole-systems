groups:
- name: node_exporter
  rules:
    - alert: filesystem_space_usage_high
      expr: (node_filesystem_size_bytes{mountpoint="/"} - node_filesystem_avail_bytes{mountpoint="/"}) / node_filesystem_size_bytes{mountpoint="/"} > 0.8
      for: 10m
      labels:
        severity: err
      annotations:
        summary: Filesystem space used high
    - alert: filesystem_inode_usage_high
      expr: (node_filesystem_files{mountpoint="/",fstype!="btrfs"} - node_filesystem_files_free{mountpoint="/",fstype!="btrfs"}) / node_filesystem_files{mountpoint="/",fstype!="btrfs"} > 0.8
      for: 10m
      labels:
        severity: err
      annotations:
        summary: Filesystem inodes used high
    - alert: memory_usage_high
      expr: (node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes > 0.8
      for: 10m
      labels:
        severity: warning
      annotations:
        summary: Memory usage high
    - alert: node_exporter_down
      expr: up{job="node"} == 0
      for: 5m
      labels:
        severity: err
      annotations:
        summary: node_exporter is down
    - alert: swap_usage_high
      expr: (node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes) / node_memory_SwapTotal_bytes > 0.8
      for: 10m
      labels:
        severity: warning
      annotations:
        summary: Swap usage high
    - alert: systemd_unit_activating
      expr: node_systemd_unit_state{state="activating",name!="raid-check.service"} == 1
      for: 10m
      labels:
        severity: warning
      annotations:
        summary: systemd unit activating
    - alert: systemd_unit_failed
      expr: node_systemd_unit_state{state="failed",name!="dnf-makecache.service"} == 1
      for: 10m
      labels:
        severity: err
      annotations:
        summary: systemd unit failed
